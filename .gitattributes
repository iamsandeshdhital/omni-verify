# Normalize line endings so the tree is identical on Windows, macOS, and Linux.
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.cff   text eol=lf
*.txt   text eol=lf

# Never rewrite these
*.png   binary
*.jpg   binary
*.mp4   binary
*.mp3   binary